{
  "_about": "Target layout of the ROOFORA Airtable base. Field names and dropdown values are a stable contract used by the n8n workflows: rename nothing without updating automation/code and rebuilding. The setup check compares the real base to this file and only ever ADDS missing tables/fields/options; it never deletes or renames.",
  "tables": [
    {
      "name": "Leads",
      "description": "One row per website enquiry: contact details, permission, stage, urgency, owner, next action and follow-up state.",
      "fields": [
        { "name": "Enquiry Ref", "type": "singleLineText", "primary": true, "note": "RF-XXXXXXXX, shown to the customer" },
        { "name": "Submission ID", "type": "singleLineText", "note": "Website-generated UUID; the duplicate-protection key" },
        { "name": "Received At", "type": "dateTime" },
        { "name": "Environment", "type": "singleSelect", "options": ["development", "preview", "production"] },
        { "name": "Full Name", "type": "singleLineText" },
        { "name": "Phone", "type": "phoneNumber" },
        { "name": "Email", "type": "email" },
        { "name": "Preferred Contact", "type": "singleSelect", "options": ["Phone", "Email"], "note": "Staff may change it when the customer asks" },
        { "name": "Property Type", "type": "singleSelect", "options": ["Residential", "Commercial", "Other"] },
        { "name": "Service", "type": "singleSelect", "options": ["Roof Installation", "Roof Repair", "Roof Replacement", "Commercial Roofing", "Storm & Leak Response", "Roof Inspections", "Not sure yet"] },
        { "name": "Town", "type": "singleLineText" },
        { "name": "Postcode", "type": "singleLineText" },
        { "name": "Roof Details", "type": "multilineText" },
        { "name": "Urgency", "type": "singleSelect", "options": ["Urgent active leak/storm damage", "This week", "This month", "Just researching"] },
        { "name": "Priority", "type": "singleSelect", "options": ["Urgent", "Normal"], "note": "Set by the automation from Urgency; separate from Stage" },
        { "name": "Roof Photos", "type": "multipleAttachments" },
        { "name": "Photos Expected", "type": "number", "precision": 0 },
        { "name": "Contact Permission", "type": "checkbox" },
        { "name": "Permission Wording", "type": "multilineText" },
        { "name": "Permission Version", "type": "singleLineText" },
        { "name": "Permission Recorded At", "type": "dateTime" },
        { "name": "Permission Withdrawn", "type": "checkbox", "note": "Tick to stop ALL automated contact" },
        { "name": "Stage", "type": "singleSelect", "options": ["New", "Contacting", "Inspection Scheduled", "Inspection Completed", "Quote Sent", "Won", "Lost", "Duplicate"] },
        { "name": "Service Area", "type": "singleSelect", "options": ["In Area", "Needs Review", "Possibly Out of Area", "Out of Area", "Not Checked"] },
        { "name": "Owner", "type": "singleLineText" },
        { "name": "Next Action", "type": "singleLineText" },
        { "name": "Next Action Due", "type": "dateTime" },
        { "name": "Last Contact At", "type": "dateTime" },
        { "name": "Last Contact Summary", "type": "singleLineText" },
        { "name": "Follow-up Status", "type": "singleSelect", "options": ["Active", "Paused - Customer Replied", "Paused - Staff Handling", "Paused - Email Bounced", "Stopped", "Completed", "Not Needed"] },
        { "name": "Follow-up Kind", "type": "singleSelect", "options": ["Enquiry", "Quote"] },
        { "name": "Follow-up Step", "type": "number", "precision": 0 },
        { "name": "Follow-up Base At", "type": "dateTime", "note": "When the current follow-up schedule started (enquiry received / quote sent)" },
        { "name": "Next Follow-up At", "type": "dateTime" },
        { "name": "Customer Replied At", "type": "dateTime" },
        { "name": "Gmail Thread IDs", "type": "multilineText", "note": "Automation-managed" },
        { "name": "Sent Message Keys", "type": "multilineText", "note": "Automation-managed: prevents the same email being sent twice" },
        { "name": "Current Quote Version", "type": "number", "precision": 0, "note": "Automation-managed" },
        { "name": "Lost Reason", "type": "singleLineText" },
        { "name": "Duplicate Of", "type": "singleLineText" },
        { "name": "Staff Notes", "type": "multilineText" }
      ]
    },
    {
      "name": "Inspections",
      "description": "Roof inspection requests and appointments. Staff enter a proposed time and press Book; the automation checks the calendar first.",
      "fields": [
        { "name": "Inspection", "type": "singleLineText", "primary": true },
        { "name": "Lead", "type": "multipleRecordLinks", "linkedTable": "Leads" },
        { "name": "Status", "type": "singleSelect", "options": ["Requested", "Scheduled", "Completed", "Cancelled", "No Show"] },
        { "name": "Customer Availability", "type": "multilineText" },
        { "name": "Proposed Start", "type": "dateTime" },
        { "name": "Duration Minutes", "type": "number", "precision": 0 },
        { "name": "Confirmed Start", "type": "dateTime" },
        { "name": "Confirmed End", "type": "dateTime" },
        { "name": "Calendar Event ID", "type": "singleLineText" },
        { "name": "Booking Version", "type": "number", "precision": 0 },
        { "name": "Reminder 24h Sent Version", "type": "number", "precision": 0 },
        { "name": "Reminder 2h Sent Version", "type": "number", "precision": 0 },
        { "name": "Inspector", "type": "singleLineText" },
        { "name": "Outcome Notes", "type": "multilineText" },
        { "name": "Last Automation Message", "type": "singleLineText" }
      ]
    },
    {
      "name": "Quotes",
      "description": "Staff-written and staff-approved quotes. Only Approved quotes can be sent. Each new version supersedes the previous one.",
      "fields": [
        { "name": "Quote", "type": "singleLineText", "primary": true },
        { "name": "Lead", "type": "multipleRecordLinks", "linkedTable": "Leads" },
        { "name": "Version", "type": "number", "precision": 0 },
        { "name": "Scope", "type": "multilineText" },
        { "name": "Amount", "type": "number", "precision": 2 },
        { "name": "Currency", "type": "singleLineText", "note": "Copied from Settings when the quote is sent" },
        { "name": "Approved", "type": "checkbox" },
        { "name": "Approved By", "type": "singleLineText" },
        { "name": "Status", "type": "singleSelect", "options": ["Draft", "Sent", "Accepted", "Declined", "Superseded", "Expired"] },
        { "name": "Sent At", "type": "dateTime" },
        { "name": "Customer Response", "type": "singleSelect", "options": ["Accepted online", "Declined online", "Accepted (recorded by staff)", "Declined (recorded by staff)"] },
        { "name": "Response At", "type": "dateTime" },
        { "name": "Link Token Hash", "type": "singleLineText", "note": "SHA-256 of the customer link token; the token itself is never stored" },
        { "name": "Link Expires At", "type": "dateTime" },
        { "name": "Gmail Message ID", "type": "singleLineText" },
        { "name": "Gmail Thread ID", "type": "singleLineText" },
        { "name": "Last Automation Message", "type": "singleLineText" }
      ]
    },
    {
      "name": "Activity",
      "description": "Tasks for staff, communication history (emails, alerts) and automation problems, all in one timeline.",
      "fields": [
        { "name": "Activity", "type": "singleLineText", "primary": true },
        { "name": "Lead", "type": "multipleRecordLinks", "linkedTable": "Leads" },
        { "name": "Type", "type": "singleSelect", "options": ["Task", "Email Sent", "Email Received", "Email Bounced", "Auto-reply", "Telegram Alert", "Calendar", "Quote", "Status Change", "Automation Problem"] },
        { "name": "Status", "type": "singleSelect", "options": ["Open", "Done", "Needs My Help", "Info"] },
        { "name": "Due At", "type": "dateTime" },
        { "name": "Owner", "type": "singleLineText" },
        { "name": "Details", "type": "multilineText" },
        { "name": "Provider ID", "type": "singleLineText" },
        { "name": "Message Key", "type": "singleLineText" },
        { "name": "Workflow Step", "type": "singleLineText" },
        { "name": "n8n Execution", "type": "singleLineText" },
        { "name": "Created At", "type": "dateTime" }
      ]
    },
    {
      "name": "Settings",
      "description": "One row of business settings read by the automation. Edit values here; no workflow change needed.",
      "fields": [
        { "name": "Name", "type": "singleLineText", "primary": true },
        { "name": "Business Name", "type": "singleLineText" },
        { "name": "Business Timezone", "type": "singleLineText", "note": "IANA name, e.g. Europe/London. Must be confirmed by the business." },
        { "name": "Opening Days", "type": "multipleSelects", "options": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] },
        { "name": "Opening Time", "type": "singleLineText", "note": "24h HH:MM" },
        { "name": "Closing Time", "type": "singleLineText", "note": "24h HH:MM" },
        { "name": "Inspection Duration Minutes", "type": "number", "precision": 0 },
        { "name": "Travel Buffer Minutes", "type": "number", "precision": 0 },
        { "name": "Service Area Postcode Prefixes", "type": "multilineText", "note": "One per line or comma separated, e.g. SW1, SE, CR0" },
        { "name": "Service Area Towns", "type": "multilineText" },
        { "name": "Default Owner", "type": "singleLineText" },
        { "name": "Urgent Owner", "type": "singleLineText" },
        { "name": "Enquiry Follow-up Business Days", "type": "singleLineText", "note": "e.g. 1,3 = next business day, then 3 business days later" },
        { "name": "Quote Follow-up Days", "type": "singleLineText", "note": "Days after the quote was sent, e.g. 2,5,10" },
        { "name": "Quote Link Valid Days", "type": "number", "precision": 0 },
        { "name": "Currency", "type": "singleLineText", "note": "ISO code, e.g. GBP" },
        { "name": "Customer Emails Enabled", "type": "checkbox", "note": "Master switch. Off = no customer email is sent at all." },
        { "name": "Test Mode", "type": "checkbox", "note": "On = every customer email goes to Test Recipient Email instead" },
        { "name": "Test Recipient Email", "type": "email" },
        { "name": "Daily Enquiry Limit", "type": "number", "precision": 0, "note": "Demo protection: maximum NEW enquiries accepted per rolling 24 hours (0 or empty = no limit). Protects the test inbox and the Airtable call allowance." },
        { "name": "Email Allowlist", "type": "multilineText", "note": "Optional hard limit: if filled in (one address per line), customer emails can ONLY go to these addresses, even if Test Mode is off." },
        { "name": "Sender Name", "type": "singleLineText" },
        { "name": "Sender Email", "type": "email", "note": "Must be the ROOFORA Gmail account or a verified send-as address of it" },
        { "name": "Business Phone", "type": "singleLineText" },
        { "name": "Website URL", "type": "url", "note": "Used to build quote links, e.g. https://roofora.example.com" },
        { "name": "Calendar ID", "type": "singleLineText", "note": "The dedicated ROOFORA Google Calendar" }
      ]
    }
  ],
  "settingsDefaults": {
    "Name": "ROOFORA settings",
    "Business Name": "ROOFORA",
    "Business Timezone": "CONFIRM e.g. Europe/London",
    "Opening Days": ["Mon", "Tue", "Wed", "Thu", "Fri"],
    "Opening Time": "08:00",
    "Closing Time": "17:00",
    "Inspection Duration Minutes": 60,
    "Travel Buffer Minutes": 30,
    "Default Owner": "Office",
    "Urgent Owner": "Office",
    "Enquiry Follow-up Business Days": "1,3",
    "Quote Follow-up Days": "2,5,10",
    "Quote Link Valid Days": 30,
    "Currency": "GBP",
    "Customer Emails Enabled": false,
    "Test Mode": true
  }
}

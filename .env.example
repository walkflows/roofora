# ROOFORA website — environment variables (names only; never commit real values).
# All are SERVER-ONLY: never prefix them with NEXT_PUBLIC_.
# Local values go in .env.local (git-ignored). Vercel values go in
# Project Settings > Environment Variables (they do not transfer automatically).

# Base URL of the ROOFORA n8n webhooks, without a trailing slash.
# Example shape: https://n8n.example.com/webhook/roofora
N8N_ROOFORA_WEBHOOK_BASE=

# Shared secret sent as the X-Roofora-Secret header. Must equal the value of the
# "ROOFORA Website Webhook" Header Auth credential in n8n.
N8N_ROOFORA_WEBHOOK_SECRET=

# 32+ random characters used to sign short-lived photo-upload permissions.
# Only the website uses it; it is not stored in n8n.
ROOFORA_PHOTO_TOKEN_SECRET=

# --- Local automation tooling only (never set on Vercel) ---
# Self-hosted n8n public API, used by automation/scripts to import and test the
# ROOFORA workflows. Create a dedicated API key in n8n > Settings > n8n API.
N8N_API_URL=
N8N_API_KEY=

# --- Staff pages (Airtable buttons) — created by automation/scripts/create-webhook-credentials.mjs ---
# Generated into .env.local for the "ROOFORA Staff Access" n8n credential (Basic Auth). Never commit.
ROOFORA_STAFF_USER=
ROOFORA_STAFF_PASSWORD=

# --- Controlled public demo ---
# If set, /api/enquiry refuses every submission without this code (checked on the server). Set it on EVERY deployment others can reach.
ROOFORA_DEMO_ACCESS_CODE=
# Public address of this deployment (metadata/sitemap). Optional; defaults to the existing project URL.
ROOFORA_SITE_URL=
